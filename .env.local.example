# Copy this file to .env.local and fill in real values from the Supabase
# dashboard (scorerush-dev project). .env.local is gitignored — never commit
# real secrets. Only variable NAMES belong here, never values.

# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API Keys -> anon public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API Keys -> service_role (SECRET — server-only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Connect (top bar) -> Connection string -> URI (Transaction pooler / port 6543 —
# lib/db/client.ts sets `prepare: false` specifically for this pgbouncer mode)
DATABASE_URL=

# football-data.org API v4 token — same variable name/token as used by the
# legacy world-cup-bets project (lib/providers/football-data/client.ts there).
# Get it from https://www.football-data.org/client/register (or reuse the
# existing token from world-cup-bets/.env.local — do not commit the value).
FOOTBALL_DATA_API_TOKEN=

# Bearer token required by /api/cron/sync (ARCHITECTURE.md §7). Generate your
# own per environment, e.g. `openssl rand -hex 32` — not shared across
# local/preview/prod. Vercel Cron automatically sends it as
# `Authorization: Bearer <value>` once set in that project's env vars.
CRON_SECRET=
